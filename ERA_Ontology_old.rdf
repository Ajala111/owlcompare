  <rdf:Description rdf:about="http://data.europa.eu/949/dNvovtrp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://data.europa.eu/949/etcsNationalValuesDataParameter"/>
    <rdfs:domain rdf:nodeID="n001fa4a63ac14c2fb1869e899abbcd6db14"/>
    <rdfs:range rdf:nodeID="n001fa4a63ac14c2fb1869e899abbcd6db17"/>
    <era:applicable>Y/N/NYA</era:applicable>
    <era:dependencyNote xml:lang="en">A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1).</era:dependencyNote>
    <era:formatNote>NNNNNNN.N whereby the last digit is only used when Q_SCALE = 10 CM</era:formatNote>
    <era:legalDeadline xml:lang="en">12 months after publication of Article 7 Guide</era:legalDeadline>
    <era:rinfIndex>1.1.1.3.2.16.5</era:rinfIndex>
    <era:rinfIndex>1.2.1.1.1.16.5</era:rinfIndex>
    <era:shaclShapeValidationRule rdf:resource="http://data.europa.eu/949/shapes/DNvovtrp"/>
    <era:shaclShapeValidationRule rdf:resource="http://data.europa.eu/949/shapes/DNvovtrpApplicability"/>
    <era:tsiOPEAppendixD3Index>1.5.5</era:tsiOPEAppendixD3Index>
    <era:unitOfMeasure rdf:resource="http://qudt.org/vocab/unit/M"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-11-07</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-08</dcterms:modified>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-18</dcterms:modified>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-05</dcterms:modified>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-02-27</dcterms:modified>
    <dcterms:relation rdf:resource="http://data.europa.eu/949/etcsLevelType"/>
    <dcterms:source rdf:resource="http://data.europa.eu/eli/reg_impl/2023/1695/oj"/>
    <rdfs:comment xml:lang="en">Maximum distance for overriding the train trip in metres, according to the specification referenced in Appendix A-1, index [C].</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/949/"/>
    <rdfs:label xml:lang="en">D_NVOVTRP</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632</rdfs:seeAlso>
    <vs:term_status>stable</vs:term_status>
    <skos:scopeNote xml:lang="en">Precision: the value must be expressed in meter. 
             
Depending on the chosen Q_SCALE, the maximal value will be: +327670 M, +32767 M or +3276.7 M.

As in TSI CCS Subset 26, chapter 7. 7.5.1.15 D_NVOVTRP.</skos:scopeNote>
  </rdf:Description>
