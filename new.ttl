era:dNvovtrp rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf era:etcsNationalValuesDataParameter ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( era:CommonCharacteristicsSubset
                                         era:ETCS
                                       )
                         ] ;
             rdfs:range [ rdf:type rdfs:Datatype ;
                          owl:onDatatype xsd:decimal ;
                          owl:withRestrictions ( [ xsd:minInclusive 0.0
                                                 ]
                                                 [ xsd:maxInclusive 327670.0
                                                 ]
                                               )
                        ] ;
             era:applicable "Y/N/NYA" ;
             era:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
             era:formatNote "NNNNNNN.N whereby the last digit is only used when Q_SCALE = 10 CM" ;
             era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
             era:rinfIndex "1.1.1.3.2.16.5" ,
                           "1.2.1.1.1.16.5" ;
             era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/DNvovtrp> ,
                                          <http://data.europa.eu/949/shapes/DNvovtrpApplicability> ;
             era:tsiOPEAppendixD3Index "1.5.5" ;
             era:unitOfMeasure unit:M ;
             dcterms:created "2022-11-07"^^xsd:date ;
             dcterms:modified "2024-01-08"^^xsd:date ,
                              "2024-04-18"^^xsd:date ,
                              "2024-12-05"^^xsd:date ,
                              "2026-02-27"^^xsd:date ;
             dcterms:relation era:etcsLevelType ;
             dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
             rdfs:comment "Maximum distance for overriding the train trip in metres, according to the specification referenced in Appendix A-1, index [C]."@en ;
             rdfs:isDefinedBy <http://data.europa.eu/949/> ;
             rdfs:label "D_NVOVTRP"@en ;
             rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
             vs:term_status "stable" ;
             skos:scopeNote """Precision: the value must be expressed in meter. 
             
Depending on the chosen Q_SCALE, the maximal value will be: +327670 M, +32767 M or +3276.7 M.

As in TSI CCS Subset 26, chapter 7. 7.5.1.15 D_NVOVTRP."""@en .


