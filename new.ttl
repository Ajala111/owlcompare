era:authorisingMemberState rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf era:vehicleTypeTechnicalObjectCharacteristic ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( era:VehicleAuthorisationCase
                                                       era:VehicleTypeAuthorisationCase
                                                     )
                                       ] ;
                           rdfs:range skos:Concept ;
