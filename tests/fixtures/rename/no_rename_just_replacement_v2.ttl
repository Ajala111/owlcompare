# fixture: no_rename_just_replacement_v2.ttl
# Pairs with no_rename_just_replacement_v1.ttl. era:Bar shares nothing with the
# removed era:Foo (different label, no parent), so no rename is inferred.

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:Asset a owl:Class ;
    rdfs:label "Asset"@en .

era:Bar a owl:Class ;
    rdfs:label "Bazzzz"@en .
