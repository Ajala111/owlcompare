# fixture: cascade_simple_v1.ttl
# Purpose: cascade consolidation. era:Track -> era:RailwayTrack (label preserved,
# high confidence). Two OTHER, persisting entities reference the renamed class:
#   - era:Tunnel subClassOf era:Track  (a hierarchy reference -> a reparent)
#   - era:measuredOn rdfs:range era:Track  (a range reference -> a range_changed)
# After the rename is accepted both references "differ only by the renamed IRI",
# so the reparent and range_changed are subsumed (cascade), leaving exactly one
# class_renamed change.

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:Asset a owl:Class ;
    rdfs:label "Asset"@en .

era:Track a owl:Class ;
    rdfs:label "Track"@en ;
    rdfs:subClassOf era:Asset .

era:Tunnel a owl:Class ;
    rdfs:label "Tunnel"@en ;
    rdfs:subClassOf era:Track .

era:measuredOn a owl:ObjectProperty ;
    rdfs:label "measured on"@en ;
    rdfs:range era:Track .
