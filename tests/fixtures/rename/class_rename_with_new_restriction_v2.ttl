# fixture: class_rename_with_new_restriction_v2.ttl
# Pairs with class_rename_with_new_restriction_v1.ttl. era:Track -> era:RailwayTrack,
# and era:Platform gains a new someValuesFrom restriction on era:hasGauge. The
# restriction is on a persisting class and is genuinely new, so it remains an
# independent restriction_added (breaking) after rename detection.

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:Asset a owl:Class ;
    rdfs:label "Asset"@en .

era:RailwayTrack a owl:Class ;
    rdfs:label "Track"@en ;
    rdfs:subClassOf era:Asset .

era:Platform a owl:Class ;
    rdfs:label "Platform"@en ;
    rdfs:subClassOf era:Asset ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty era:hasGauge ;
        owl:someValuesFrom era:Gauge
    ] .

era:Gauge a owl:Class ;
    rdfs:label "Gauge"@en .

era:hasGauge a owl:ObjectProperty ;
    rdfs:label "has gauge"@en .
