# fixture: ambiguous_label_match_v2.ttl
# Pairs with ambiguous_label_match_v1.ttl. Two added classes both labelled
# "Asset"@en make the removed era:Thing ambiguous, so no high-confidence rename
# is emitted (era:Thing stays class_removed; both stay class_added).

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:Asset1 a owl:Class ;
    rdfs:label "Asset"@en .

era:Asset2 a owl:Class ;
    rdfs:label "Asset"@en .
