# fixture: fingerprint_rename_v1.ttl
# Purpose: the medium-confidence (structural fingerprint) case. era:Track is
# renamed to era:RailwayTrack in v2 AND its label changes ("Track"@en ->
# "Railway Track"@en), so label matching CANNOT see the rename. The structural
# fingerprint still matches strongly: same two parents (era:Asset, era:Vehicle),
# and the same incoming references (era:Tunnel subClassOf it; era:hasPart has it
# as both domain and range). Score = parents 0.4 + incoming 0.3 + shared outgoing
# predicates >= 0.6, so a medium-confidence rename fires but a high one does not.

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:Asset a owl:Class ;
    rdfs:label "Asset"@en .

era:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en .

era:Track a owl:Class ;
    rdfs:label "Track"@en ;
    rdfs:subClassOf era:Asset ;
    rdfs:subClassOf era:Vehicle .

era:Tunnel a owl:Class ;
    rdfs:label "Tunnel"@en ;
    rdfs:subClassOf era:Track .

era:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    rdfs:domain era:Track ;
    rdfs:range era:Track .
