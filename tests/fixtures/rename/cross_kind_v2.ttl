# fixture: cross_kind_v2.ttl
# Pairs with cross_kind_v1.ttl. The added object property shares the removed
# class's label, but matching is confined within a kind, so this stays a
# class_removed + object_property_added (no rename).

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:bar a owl:ObjectProperty ;
    rdfs:label "Shared"@en .
