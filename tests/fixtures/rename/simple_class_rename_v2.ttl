# fixture: simple_class_rename_v2.ttl
# Pairs with simple_class_rename_v1.ttl. era:Track -> era:RailwayTrack; the label
# "Track"@en and the parent era:Asset are carried over verbatim so the label
# heuristic pairs them at high confidence.

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:Asset a owl:Class ;
    rdfs:label "Asset"@en .

era:RailwayTrack a owl:Class ;
    rdfs:label "Track"@en ;
    rdfs:subClassOf era:Asset .
