# fixture: rename_plus_new_parent_v2.ttl
# Pairs with rename_plus_new_parent_v1.ttl. era:Track -> era:RailwayTrack (label
# preserved -> high confidence) and the renamed class gains a new parent edge
# rdfs:subClassOf era:Infrastructure. Re-diff should emit one class_parent_added.

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:Asset a owl:Class ;
    rdfs:label "Asset"@en .

era:Infrastructure a owl:Class ;
    rdfs:label "Infrastructure"@en .

era:RailwayTrack a owl:Class ;
    rdfs:label "Track"@en ;
    rdfs:subClassOf era:Asset ;
    rdfs:subClassOf era:Infrastructure .
