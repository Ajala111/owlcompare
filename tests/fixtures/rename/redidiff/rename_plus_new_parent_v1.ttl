# fixture: rename_plus_new_parent_v1.ttl
# Purpose (Component 12 Part A / DD-018): a class is renamed AND gains a new
# subClassOf parent edge. era:Track -> era:RailwayTrack (label "Track"@en
# preserved -> high-confidence rename). In v2 the renamed class gains a second
# parent (era:Infrastructure); the re-diff must surface one class_parent_added.

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:Asset a owl:Class ;
    rdfs:label "Asset"@en .

era:Infrastructure a owl:Class ;
    rdfs:label "Infrastructure"@en .

era:Track a owl:Class ;
    rdfs:label "Track"@en ;
    rdfs:subClassOf era:Asset .
