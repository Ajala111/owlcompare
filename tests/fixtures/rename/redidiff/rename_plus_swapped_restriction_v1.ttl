# fixture: rename_plus_swapped_restriction_v1.ttl
# Purpose (Component 12 Part A / DD-018): a class is renamed AND the kind of an
# existing restriction on it changes. era:Track -> era:RailwayTrack (label
# "Track"@en preserved -> high-confidence rename). Here the restriction is
# someValuesFrom era:Gauge; in v2 it becomes allValuesFrom era:Gauge. The re-diff
# must surface one restriction_changed (a kind change -> breaking).

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:Asset a owl:Class ;
    rdfs:label "Asset"@en .

era:Gauge a owl:Class ;
    rdfs:label "Gauge"@en .

era:hasGauge a owl:ObjectProperty ;
    rdfs:label "has gauge"@en .

era:Track a owl:Class ;
    rdfs:label "Track"@en ;
    rdfs:subClassOf era:Asset ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty era:hasGauge ;
        owl:someValuesFrom era:Gauge
    ] .
