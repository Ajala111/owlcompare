# fixture: html_escaping_before.ttl
# Purpose: baseline for the HTML escaping golden (specs/17-html-report.md
# § Edge cases — labels containing HTML-like text). Just a base class so v2's
# additions are the only changes.

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Base a owl:Class ;
    rdfs:label "Base"@en .
