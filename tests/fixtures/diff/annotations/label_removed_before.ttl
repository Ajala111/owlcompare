# fixture: label_removed_before.ttl
# Purpose: baseline with an English label. Pairs with label_removed_after.ttl,
# which drops rdfs:label "Track"@en (the German label stays) — one
# annotation_removed, language en.

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Track a owl:Class ;
    rdfs:label "Track"@en ;
    rdfs:label "Gleis"@de .
