# fixture: deprecated_removed_before.ttl
# Purpose: baseline where ex:Track is deprecated. Pairs with
# deprecated_removed_after.ttl, which removes owl:deprecated true — one
# entity_undeprecated (info).

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Track a owl:Class ;
    rdfs:label "Track"@en ;
    owl:deprecated true .
