# fixture: label_changed_different_lang_after.ttl
# Purpose: v2 of the French label change. ex:Track's @fr label is now
# "Voie ferrée". See label_changed_different_lang_before.ttl.

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Track a owl:Class ;
    rdfs:label "Voie ferrée"@fr .
