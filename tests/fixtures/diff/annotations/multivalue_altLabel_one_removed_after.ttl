# fixture: multivalue_altLabel_one_removed_after.ttl
# Purpose: v2 keeps two of the three altLabels; "Track Bed"@en is gone. See
# multivalue_altLabel_one_removed_before.ttl.

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:Track a owl:Class ;
    rdfs:label "Track"@en ;
    skos:altLabel "Rail"@en ;
    skos:altLabel "Permanent Way"@en .
