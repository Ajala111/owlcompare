# fixture: restriction_removed_before.ttl
# Purpose: baseline for a restriction removal. ex:Track has two restrictions: a
# max 1 cardinality on ex:hasSpeed and an existential someValuesFrom ex:Gauge on
# ex:hasGauge. Pairs with restriction_removed_after.ttl, which drops the
# cardinality restriction but keeps the existential one — exercising that only
# the removed restriction is reported (non_breaking) and the retained one is not.

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Gauge a owl:Class .
ex:Track a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ex:hasSpeed ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ,
    [
        a owl:Restriction ;
        owl:onProperty ex:hasGauge ;
        owl:someValuesFrom ex:Gauge
    ] .
