# fixture: qualified_cardinality_before.ttl
# Purpose: baseline for a qualified cardinality restriction. ex:Track has a
# min 1 qualified cardinality on ex:hasGauge with a typed filler (owl:onClass
# ex:Gauge). Pairs with qualified_cardinality_after.ttl (min 2), so the decoder
# and the diff both see a qualified-cardinality shape with a filler.

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Gauge a owl:Class .
ex:Track a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ex:hasGauge ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass ex:Gauge
    ] .
