# fixture: domain_extended_after.ttl
# Purpose: ex:locatedOn gains ex:Platform as a second domain alongside ex:Signal
# relative to domain_extended_before.ttl (non_breaking domain_added).

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Signal a owl:Class .
ex:Platform a owl:Class .
ex:locatedOn a owl:ObjectProperty ;
    rdfs:domain ex:Signal ,
        ex:Platform .
