# fixture: someValues_filler_widened_after.ttl
# Purpose: widened version of someValues_filler_widened_before.ttl. The
# someValuesFrom filler on ex:hasGauge moves from ex:NarrowGauge to its
# superclass ex:Gauge (non_breaking).

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Gauge a owl:Class .
ex:NarrowGauge a owl:Class ;
    rdfs:subClassOf ex:Gauge .
ex:Track a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ex:hasGauge ;
        owl:someValuesFrom ex:Gauge
    ] .
