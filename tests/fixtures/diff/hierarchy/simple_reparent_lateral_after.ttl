# fixture: simple_reparent_lateral_after.ttl
# Purpose: ex:A reparented from ex:B to the incomparable ex:D. Expected: one
# class_reparented with direction=lateral and severity=breaking.

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:B a owl:Class .
ex:D a owl:Class .
ex:A a owl:Class ;
    rdfs:subClassOf ex:D .
