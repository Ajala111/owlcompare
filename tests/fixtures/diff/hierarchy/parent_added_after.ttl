# fixture: parent_added_after.ttl
# Purpose: ex:Dog gains a second, broader parent ex:Animal (an ancestor of its
# existing parent ex:Mammal). Expected: one class_parent_added with
# direction=generalization and severity=additive.

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Animal a owl:Class .
ex:Mammal a owl:Class ;
    rdfs:subClassOf ex:Animal .
ex:Dog a owl:Class ;
    rdfs:subClassOf ex:Mammal ;
    rdfs:subClassOf ex:Animal .
