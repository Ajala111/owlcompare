# fixture: class_added_before.ttl
# Purpose: baseline for the "exactly one class added" Layer 1 case. Pairs with
# class_added_after.ttl, which introduces ex:Dog (declaration + one label).

@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Animal a owl:Class ;
    rdfs:label "Animal"@en .
