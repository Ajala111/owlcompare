# fixture: annotation_on_deprecated_v2.ttl
# Purpose: v2 of the Rule 2 pair. era:Track's French label changes and era:Track
# is now owl:deprecated true. See _v1 for the intent.

@prefix era: <http://data.europa.eu/949/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

era:Track a owl:Class ;
    rdfs:label "Track"@en ;
    rdfs:label "Voie ferrée"@fr ;
    owl:deprecated true .

era:Signal a owl:Class ;
    rdfs:label "Signal"@en .
