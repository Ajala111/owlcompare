# fixture: deprecated.ttl
# Purpose: one class marked owl:deprecated true and one not. Used to confirm
# Entity.is_deprecated is True only when the flag is set.

@prefix : <http://example.org/dep#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/dep> a owl:Ontology .

:OldThing a owl:Class ;
    rdfs:label "OldThing"@en ;
    owl:deprecated "true"^^xsd:boolean .

:NewThing a owl:Class ;
    rdfs:label "NewThing"@en .
