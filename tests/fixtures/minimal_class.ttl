# fixture: minimal_class.ttl
# Purpose: the simplest possible ontology — one class, one object property,
# one named individual. Used as the baseline smoke test for the loader.

@prefix : <http://example.org/minimal#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/minimal> a owl:Ontology .

:Thing a owl:Class ;
    rdfs:label "Thing"@en .

:hasFriend a owl:ObjectProperty ;
    rdfs:domain :Thing ;
    rdfs:range :Thing ;
    rdfs:label "has friend"@en .

:alice a owl:NamedIndividual, :Thing ;
    rdfs:label "Alice"@en .
